# Port the internal API server listens on. The frontend (Vite) serves everything on 8080
# and proxies /api and /health here, so you normally never open this port directly.
API_PORT=8787
# Public port for the app (the frontend dev server). Lovable's Vite config pins this to 8080.
APP_PORT=8080

# SQLite database file (created on first boot).
DB_PATH=./data/jobradar.db

# Identify ourselves honestly to every site we fetch. Put a real contact URL/email here.
USER_AGENT=JobRadarBot/2.0 (+https://github.com/your-org/jobradar; student job-tracker)

# Minimum delay between two requests to the same domain, in milliseconds.
PER_DOMAIN_DELAY_MS=1200
# HTTP timeout per request (ms) and retry attempts with exponential backoff.
REQUEST_TIMEOUT_MS=20000
REQUEST_RETRIES=3
# How long successful responses are cached (ms) to avoid refetching within a burst.
HTTP_CACHE_TTL_MS=900000

# Scheduled refresh (node-cron syntax). Default: every 4 hours.
REFRESH_CRON=0 */4 * * *
# Scrape Chennai + Global automatically on first boot when the DB is empty.
INITIAL_SCRAPE=true

# FX cache lifetime in hours.
FX_TTL_HOURS=12

# Log level: debug | info | warn | error
LOG_LEVEL=info
